# OpenWebUI's WEBUI_SECRET_KEY, so the server accepts the users' own tokens.
JWT_SECRET=
# HS256 for OpenWebUI.
JWT_ALGORITHM=HS256

# OpenWebUI as reached from this server; attachments and uploads go there.
OWUI_BASE_URL=http://localhost:3000
# OpenWebUI as reached by users, for download links; omit if the same.
OWUI_PUBLIC_URL=http://localhost:3000
# false only for self-signed or plain HTTP; corporate CAs go via SSL_CERT_FILE.
OWUI_VERIFY_TLS=true

# valkey://[:password@]host:port[/db]; the compose file provides this one.
VALKEY_URL=valkey://valkey:6379

# Requests in flight per process and per user; excess ones are told to retry.
MAX_CONCURRENT_REQUESTS=32
MAX_CONCURRENT_REQUESTS_PER_USER=2

# Per-user token bucket: sustained requests per second and the burst it allows.
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

# OfficeCLI processes at once; others queue up to OFFICECLI_QUEUE_TIMEOUT.
OFFICECLI_MAX_PROCESSES=4
# MB of managed heap per OfficeCLI run; a run over it is killed, not the server.
OFFICECLI_MAX_MEMORY=1024
# Seconds one OfficeCLI run may take.
OFFICECLI_TIMEOUT=120
# Seconds a request waits for the lock and a free process, then answers busy.
OFFICECLI_QUEUE_TIMEOUT=30

# Projects a user may hold at once; older ones only go away by expiring.
PROJECT_MAX_PER_USER=20
# Seconds of inactivity until a project expires; every access renews it.
PROJECT_TTL=86400
